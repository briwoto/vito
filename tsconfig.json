{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"lib": ["ES2022"],
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"],
		"outDir": "./dist",
		"rootDir": "./"
	},
	"include": [
		"src/**/*",
		"step-definitions/**/*",
		"playwright.config.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
